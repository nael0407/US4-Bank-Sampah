    {
      "name": "Saldo",
      "item": [
        {
          "name": "Saldo Saya (nasabah)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/saldo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "saldo"
              ]
            }
          }
        },
        {
          "name": "Mutasi Saya (nasabah)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/saldo/mutasi?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "saldo",
                "mutasi"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Saldo Nasabah (petugas/admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/saldo?nasabahId={{nasabahId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "saldo"
              ],
              "query": [
                {
                  "key": "nasabahId",
                  "value": "{{nasabahId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Mutasi Nasabah (petugas/admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/saldo/mutasi?nasabahId={{nasabahId}}&tipe=SETORAN",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "saldo",
                "mutasi"
              ],
              "query": [
                {
                  "key": "nasabahId",
                  "value": "{{nasabahId}}"
                },
                {
                  "key": "tipe",
                  "value": "SETORAN"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Setoran",
      "item": [
        {
          "name": "Catat Setoran (petugas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"setoranId\", pm.response.json().setoran._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
