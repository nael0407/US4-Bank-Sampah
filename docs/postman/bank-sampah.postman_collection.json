              ],
              "path": [
                "setoran"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nasabahId\": \"{{nasabahId}}\",\n  \"items\": [\n    {\n      \"jenisSampahId\": \"{{jenisSampahId}}\",\n      \"berat\": 2.5\n    }\n  ]\n}",
              "options": {
